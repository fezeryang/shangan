# ============ AI 引擎配置 ============
# AI_PROVIDER: 指定 AI 引擎 gemini | deepseek
# 不设置时的自动策略：配置了 DEEPSEEK_API_KEY 则使用 deepseek，否则使用 gemini
# AI_PROVIDER=deepseek

# ---- DeepSeek（OpenAI 兼容协议，https://platform.deepseek.com）----
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"
# DEEPSEEK_MODEL: deepseek-chat (V3 通用) | deepseek-reasoner (R1 深度推理)
# DEEPSEEK_MODEL="deepseek-chat"
# DEEPSEEK_BASE_URL="https://api.deepseek.com"

# ---- Gemini ----
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL="gemini-3.7-flash"

# ============ 站点配置 ============
# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
