# ============ AI 引擎配置 ============
# AI_PROVIDER: 指定主 AI 引擎 gemini | deepseek | minimax | openai | anthropic
#   - gemini    : Google Gemini（GoogleGenAI SDK）
#   - deepseek  : DeepSeek（OpenAI 兼容协议）
#   - minimax   : MiniMax Coding Plan（Anthropic 兼容协议，M2/M2.7 等）
#   - openai    : 自定义中转站（OpenAI 兼容协议）
#   - anthropic : Claude / 自定义中转站（Anthropic 兼容协议）
# 不设置时的自动策略（按已配置 key 的优先级）：
#   MINIMAX_API_KEY > DEEPSEEK_API_KEY > ANTHROPIC_API_KEY > OPENAI_API_KEY > gemini
# AI_PROVIDER=openai

# AI_FALLBACK_PROVIDER: 主引擎调用失败时自动切换的兜底引擎。
# 不设置时：只要配置了 MINIMAX_API_KEY 且主引擎不是 minimax，就自动用 MiniMax 兜底。
# AI_FALLBACK_PROVIDER=minimax

# ---- MiniMax（Anthropic 兼容协议，coding plan 推荐 M 系列）----
# 国内站：https://api.minimaxi.com/anthropic（大多数国内 key 用这个）
# 国际站：https://api.minimax.io/anthropic
# 模型推荐：MiniMax-M2 / MiniMax-M2.7 / MiniMax-M3（以你后台实际开通为准）
MINIMAX_API_KEY="MY_MINIMAX_API_KEY"
# MINIMAX_MODEL="MiniMax-M3"
# MINIMAX_BASE_URL="https://api.minimaxi.com/anthropic"

# ---- Anthropic 中转站（Claude 或任意 Anthropic 协议网关）----
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"
# ANTHROPIC_BASE_URL="https://api.anthropic.com"
# ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# ---- DeepSeek（OpenAI 兼容协议，https://platform.deepseek.com）----
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"
# DEEPSEEK_MODEL="deepseek-chat"
# DEEPSEEK_BASE_URL="https://api.deepseek.com"

# ---- 自定义 OpenAI 中转站（任意 OpenAI 兼容协议聚合站 / 自建网关）----
OPENAI_API_KEY="MY_RELAY_API_KEY"
# OPENAI_BASE_URL="https://your-relay.example.com/v1"
# OPENAI_MODEL="gpt-4o-mini"

# ---- Gemini ----
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL="gemini-2.5-flash"

# ============ 站点配置 ============
# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
